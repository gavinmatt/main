---
import BaseLayout from "../layouts/BaseLayout.astro";
import FlightMap from "../components/FlightMap.tsx";
import DensityMap from "../components/DensityMap.tsx";
---

<BaseLayout
  sideBarActiveItemID="flight-tracker"
  customTitle="Flight Tracker"
  description="Live ADS-B aircraft tracking from a personal antenna in northwest Montana. View current overhead flights and the furthest-away aircraft ever received."
  canonical="https://www.gavmatt.com/flight-tracker"
  ogImage="https://www.gavmatt.com/flight-tracker.jpg"
  wide
>
  <!-- HEADER -->
  <div class="text-5xl font-bold text-center mt-6">
    Live air traffic near Whitefish, MT
  </div>

  <p class="text-center py-4 max-w-3xl mx-auto">
    All data is captured from my home ADS-B antenna setup and reflects only
    aircraft my local receiver can hear (not aggregated radar data).
    <a href="/blog/flight-tracking" class="underline">Learn more</a>.
  </p>

  <!-- RADAR -->
  <div class="flex justify-center px-4">
    <FlightMap client:only="react" />
  </div>

  <!-- DASHBOARD -->
  <div class="dash-grid w-full mt-12">
    <!-- CARD: OVERHEAD -->
    <section class="dash-card dash-wide">
      <div class="dash-head">
        <h2 class="dash-title">What's overhead?</h2>
        <span id="overheadCount" class="text-sm font-semibold text-base-content/70"></span>
      </div>
      <p class="dash-note">
        Planes in reach of my antenna right now, furthest first. "—" means the
        plane didn't send that value, which is common at range.
        <span id="lastUpdated" class="text-base-content/50"></span>
      </p>

      <div
        id="emptyState"
        class="hidden my-2 text-center border border-dashed border-base-300 rounded-lg py-10 px-6 text-base-content/50"
      >
        <div class="text-lg font-semibold mb-2">No aircraft currently in range</div>
        <p class="text-sm">
          My receiver is online and listening, but there are no aircraft
          transmitting decodable ADS-B data within range right now.
        </p>
      </div>

      <div class="overflow-auto md:max-h-[34rem]">
        <table class="w-full border-collapse text-sm text-base-content">
          <thead class="sticky top-0 bg-base-100 z-[1]">
            <tr class="border-b border-base-300 text-base-content/70">
              <th class="text-left py-2 px-1.5">Interesting?</th>
              <th class="text-left py-2 px-1.5">Airline</th>
              <th class="text-left py-2 px-1.5 hidden sm:table-cell">Callsign</th>
              <th class="text-left py-2 px-1.5 hidden md:table-cell">Type</th>
              <th class="text-left py-2 px-1.5 hidden lg:table-cell">ICAO</th>
              <th class="text-right py-2 px-1.5">Alt (ft)</th>
              <th class="text-right py-2 px-1.5 hidden md:table-cell">Speed (kt)</th>
              <th class="text-right py-2 px-1.5 hidden lg:table-cell">Squawk</th>
              <th class="text-right py-2 px-1.5">Dist (NM)</th>
              <th class="text-right py-2 px-1.5 hidden md:table-cell">Seen (s)</th>
            </tr>
          </thead>
          <tbody id="flightBody" class="text-base-content"></tbody>
        </table>
      </div>
    </section>

    <!-- CARD: DISTANT PINGS -->
    <section class="dash-card">
      <div class="dash-head">
        <h2 class="dash-title">Distant pings</h2>
      </div>
      <p class="dash-note">Furthest away aircraft I've tracked. 1 NM = ~1.15 miles. Planes that never sent a callsign go by their transponder address and the country it's registered to.</p>
      <p class="dash-subnote" id="notableScale">
        Ratings compare each ping with my receiver's recent days.
      </p>

      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm text-base-content">
          <thead>
            <tr class="border-b border-base-300 text-base-content/70">
              <th class="text-center py-2 px-1.5 w-8"><span class="sr-only">Ranking</span></th>
              <th class="text-left py-2 px-1.5">Rating</th>
              <th class="text-left py-2 px-1.5">Aircraft</th>
              <th class="text-left py-2 px-1.5 hidden sm:table-cell">Direction</th>
              <th class="text-right py-2 px-1.5">NM</th>
              <th class="text-right py-2 px-1.5">Date</th>
            </tr>
          </thead>
          <tbody id="notableBody"></tbody>
        </table>
      </div>
    </section>

    <!-- CARD: FREQUENT FLIERS -->
    <section class="dash-card">
      <div class="dash-head">
        <h2 class="dash-title">Frequent fliers</h2>
      </div>
      <p class="dash-note">
        Callsigns I've seen most often over the last 90 days, effectively the
        busiest routes over my antenna.
      </p>
      <p class="dash-subnote">
        Each callsign counts once for every hour it's in range.
        <span id="frequentSince"></span>
      </p>

      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm text-base-content">
          <thead>
            <tr class="border-b border-base-300 text-base-content/70">
              <th class="text-center py-2 px-1.5 w-8"><span class="sr-only">Ranking</span></th>
              <th class="text-left py-2 px-1.5">Airline</th>
              <th class="text-left py-2 px-1.5 hidden sm:table-cell">Callsign</th>
              <th class="text-right py-2 px-1.5">Hours</th>
              <th class="text-right py-2 px-1.5">Last seen</th>
            </tr>
          </thead>
          <tbody id="frequentFliersBody"></tbody>
        </table>
      </div>
    </section>

    <!-- CARD: DENSITY MAP -->
    <section class="dash-card dash-wide">
      <div class="dash-head">
        <h2 class="dash-title">Where planes fly</h2>
      </div>
      <p class="dash-note">
        Every plane my antenna has heard over the last three months, mapped
        onto ~3 NM squares. The bright lines are the airways overhead.
      </p>
      <p class="dash-subnote">
        Brighter squares are where more planes pass. Each plane counts once
        per square per hour, so one plane circling overhead can't pass for an
        airway. Only clean ADS-B positions count.
      </p>
      <DensityMap client:only="react" />
    </section>

    <!-- CARD: COVERAGE ROSE -->
    <section class="dash-card dash-wide">
      <div class="dash-head">
        <h2 class="dash-title">Coverage by direction</h2>
      </div>
      <p class="dash-note">
        How far my antenna hears in each direction, in 10° slices. Mountains,
        buildings and the antenna's own placement all show up as short slices.
      </p>
      <p class="dash-subnote">
        Dark wedges are a typical day's furthest plane in that direction (the
        median day); the faint wedges behind are the single best ping. Rings
        every 50 NM. Directions with no flights to hear stay empty.
      </p>

      <div class="grid gap-6 md:grid-cols-[minmax(0,26rem)_1fr] items-start">
        <div id="coverageRose" class="w-full max-w-[26rem] mx-auto aspect-square"></div>
        <div>
          <div class="flex flex-wrap gap-1 mb-4" id="coverageWindows">
            <button class="btn btn-xs sm:btn-sm" data-window="7">Last 7 days</button>
            <button class="btn btn-xs sm:btn-sm" data-window="30">Last 30 days</button>
            <button class="btn btn-xs sm:btn-sm" data-window="90">Last 90 days</button>
          </div>
          <dl id="coverageStats" class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm"></dl>
          <p id="coverageSince" class="text-xs text-base-content/50 mt-4"></p>
        </div>
      </div>
    </section>

    <!-- CARD: HEATMAP -->
    <section class="dash-card dash-wide">
      <div class="dash-head">
        <h2 class="dash-title">Traffic heatmap</h2>
      </div>
      <p class="dash-note">
        Average number of planes in range each hour, by day of week (Mountain
        Time, last 90 days).
      </p>
      <p class="dash-subnote">
        Each plane counts once per hour, however long it stays. Hover or tap a
        cell for its most common airline. The outlined cell is now.
        <span id="heatmapSince"></span>
      </p>

      <div class="flex flex-wrap gap-x-4 gap-y-2 mb-4">
        <div class="flex flex-wrap gap-1" id="heatmapTypes">
          <button class="btn btn-xs sm:btn-sm" data-type="all">All</button>
          <button class="btn btn-xs sm:btn-sm" data-type="airline">Commercial</button>
          <button class="btn btn-xs sm:btn-sm" data-type="private">Private</button>
          <button class="btn btn-xs sm:btn-sm" data-type="military">Military</button>
          <button class="btn btn-xs sm:btn-sm" data-type="heli">Helicopters</button>
          <button class="btn btn-xs sm:btn-sm" data-type="skydive">Skydiving</button>
          <button class="btn btn-xs sm:btn-sm" data-type="other">Other</button>
        </div>
        <div class="flex flex-wrap gap-1" id="heatmapScopes">
          <button class="btn btn-xs sm:btn-sm" data-scope="any">Everything in range</button>
          <button class="btn btn-xs sm:btn-sm" data-scope="near">Within 15 NM</button>
        </div>
      </div>

      <div id="heatmapGrid"></div>
    </section>
  </div>

  <!-- SCRIPT -->
  <script>
    import {
      airlineFromCallsign,
      airlineFromFlight,
      callsignRaw,
      classifyNotability,
      countryFromHex,
      distanceNm,
      escapeHtml,
      hexUpper,
      isUnknownAirline,
      militaryBranch,
    } from "../lib/flightClassify.js";
    import { subscribeFlights } from "../lib/flightFeed.js";
    import { pollWhileVisible } from "../lib/poll.js";

    /* ---------- CONSTANTS ---------- */

    const tbody = document.getElementById("flightBody");
    const emptyStateEl = document.getElementById("emptyState");
    const lastUpdatedEl = document.getElementById("lastUpdated");
    const overheadCountEl = document.getElementById("overheadCount");
    const STALE_AFTER_MS = 90_000;

    const RX_LAT = 48.41;
    const RX_LON = -114.444;

    /* ---------- UTILS ---------- */

    function aircraftDistance(f) {
      if (f.lat == null || f.lon == null) return null;
      return distanceNm(RX_LAT, RX_LON, f.lat, f.lon);
    }

    function distanceFlag(d) {
      if (d > 250)
        return { label: "EXTREME", cls: "bg-purple-100 text-purple-800" };
      if (d > 200)
        return { label: "LONG-RANGE", cls: "bg-indigo-100 text-indigo-800" };
      if (d > 150)
        return { label: "DISTANT", cls: "bg-blue-100 text-blue-800" };
      return null;
    }

    function notableLabelForFlight(f) {
      const branch = militaryBranch(f);
      if (branch) return branch.replace(" (TANKER)", "");
      const airline = airlineFromFlight(f);
      if (airline !== "—" && airline !== "Undetermined") return airline;
      // No operator to name, so say what the plane is: its size class and where it's
      // registered, e.g. "Canadian light aircraft".
      const size = CATEGORY_LABELS[f.category];
      const country = countryFromHex(f.hex);
      if (size && country) return `${country} ${size[0].toLowerCase()}${size.slice(1)}`;
      if (size) return size;
      return country ? `${country} aircraft` : "Unidentified aircraft";
    }

    // Ratings come from the receiver's own recent days (each day's furthest plane, last
    // 30 days), so they stay meaningful as the antenna improves. Fixed thresholds until
    // there's a week of data.
    const MIN_RANGE_DAYS = 7;
    const FALLBACK_RANGE = { median: 170, p90: 205, best: 250 };
    const NOTABLE_TIERS = [
      { key: "best", label: "AMAZING", cls: "bg-purple-100 text-purple-800" },
      { key: "p90", label: "GREAT", cls: "bg-indigo-100 text-indigo-800" },
      { key: "median", label: "GOOD", cls: "bg-blue-100 text-blue-800" },
    ];

    const rangeThresholds = (range) =>
      range && range.days >= MIN_RANGE_DAYS ? range : FALLBACK_RANGE;

    function notableDistanceLabel(d, range) {
      const t = rangeThresholds(range);
      return NOTABLE_TIERS.find((tier) => d >= t[tier.key]) ?? null;
    }

    function renderNotableScale(range) {
      const el = document.getElementById("notableScale");
      if (!el) return;
      const t = rangeThresholds(range);
      const basis = t === FALLBACK_RANGE
        ? `Ratings use fixed thresholds until there's a week of range data`
        : `Ratings compare each ping with my receiver's last ${range.days} days`;
      el.textContent = `${basis}: good = ${t.median}+ NM (a typical day's furthest plane), great = ${t.p90}+ NM (better than 90% of days), amazing = ${t.best}+ NM (a new 30-day best). Click a date to see that flight's track.`;
    }

    // Phones fold the callsign column under the airline to save a column.
    const phoneCallsign = (cs) =>
      `<div class="sm:hidden text-xs text-base-content/50">${escapeHtml(cs)}</div>`;

    /* ---------- NOTABLES ---------- */

    function renderNotables(rows, range) {
      renderNotableScale(range);
      const notableBody = document.getElementById("notableBody");
      if (!notableBody) return;
      if (!rows || !rows.length) {
        notableBody.innerHTML = `<tr><td colspan="6" class="text-center py-6 text-base-content/50">No notable pings recorded yet.</td></tr>`;
        return;
      }
      const medals = ["🥇", "🥈", "🥉"];
      notableBody.innerHTML = rows
        .map((r, i) => {
          const noCallsign = /^no callsign$/i.test(r.callsign ?? "");
          const fakeFlight = { flight: noCallsign ? "" : r.callsign, hex: r.hex, category: r.category };
          const aircraft = r.airline && r.airline !== "—" ? r.airline : notableLabelForFlight(fakeFlight);
          // Without a callsign, the transponder address is what identifies the plane.
          const id = noCallsign
            ? `<span class="font-mono" title="No callsign sent; this is its transponder address">${escapeHtml(r.hex.toUpperCase())}</span>`
            : escapeHtml(r.callsign);
          const direction = r.bearing != null ? compassName(r.bearing) : "";
          const altitude = r.altitude > 0 ? `${(Math.round(r.altitude / 100) * 100).toLocaleString()} ft` : "";
          const rank = medals[i] ?? "";
          const label = notableDistanceLabel(r.maxDistance, range);
          const date = new Date(r.lastSeen);
          // ADS-B Exchange keeps every plane's track by UTC date.
          const trace = `https://globe.adsbexchange.com/?icao=${encodeURIComponent(r.hex)}&showTrace=${date.toISOString().slice(0, 10)}`;
          return `
          <tr class="border-b border-base-300">
            <td class="text-center py-2 px-1.5 text-lg">${rank}</td>
            <td class="py-2 px-1.5">
              ${label ? `<span class="px-2 py-0.5 rounded text-xs font-medium ${label.cls}">${label.label}</span>` : "—"}
            </td>
            <td class="py-2 px-1.5 whitespace-nowrap">
              ${escapeHtml(aircraft)}
              <div class="text-xs text-base-content/50">${id}${direction ? `<span class="sm:hidden"> · ${direction}</span>` : ""}</div>
            </td>
            <td class="py-2 px-1.5 whitespace-nowrap hidden sm:table-cell">
              ${direction}
              ${altitude ? `<div class="text-xs text-base-content/50">at ${altitude}</div>` : ""}
            </td>
            <td class="text-right py-2 px-1.5 font-semibold">${escapeHtml(r.maxDistance)}</td>
            <td class="text-right py-2 px-1.5 whitespace-nowrap"><a class="link" href="${trace}" target="_blank" rel="noopener">${date.toLocaleDateString(undefined, { month: "short", day: "numeric" })}</a></td>
          </tr>`;
        })
        .join("");
    }

    async function loadNotables() {
      try {
        const res = await fetch("/api/notable-pings");
        const data = await res.json();
        renderNotables(data.rows ?? [], data.range);
      } catch {}
    }

    /* ---------- FREQUENT FLIERS ---------- */

    function renderFrequentFliers(rows) {
      const ffBody = document.getElementById("frequentFliersBody");
      if (!ffBody) return;
      if (!rows || !rows.length) {
        ffBody.innerHTML = `<tr><td colspan="5" class="text-center py-6 text-base-content/50">No frequent fliers recorded yet.</td></tr>`;
        return;
      }
      const medals = ["🥇", "🥈", "🥉"];
      ffBody.innerHTML = rows
        .map((r, i) => {
          const rank = medals[i] ?? "";
          return `
          <tr class="border-b border-base-300">
            <td class="text-center py-2 px-1.5 text-lg">${rank}</td>
            <td class="py-2 px-1.5 whitespace-nowrap">${escapeHtml(airlineFromCallsign(r.callsign))}${phoneCallsign(r.callsign)}</td>
            <td class="py-2 px-1.5 font-mono hidden sm:table-cell">${escapeHtml(r.callsign)}</td>
            <td class="text-right py-2 px-1.5 font-semibold">${escapeHtml(r.count)}</td>
            <td class="text-right py-2 px-1.5 whitespace-nowrap">${new Date(`${r.lastDay}T12:00:00`).toLocaleDateString(undefined, { month: "short", day: "numeric" })}</td>
          </tr>`;
        })
        .join("");
    }

    async function loadFrequentFliers() {
      try {
        const res = await fetch("/api/frequent-fliers");
        const data = await res.json();
        const since = document.getElementById("frequentSince");
        const sinceDate = data.since && new Date(`${data.since}T12:00:00`);
        if (since)
          since.textContent = sinceDate && Date.now() - sinceDate < 89 * 86400000
            ? ` Counting since ${sinceDate.toLocaleDateString(undefined, { month: "short", day: "numeric" })}.`
            : "";
        renderFrequentFliers(data.rows ?? []);
      } catch {}
    }

    // ADS-B emitter categories are weight classes, not engine types.
    const CATEGORY_LABELS = {
      A1: "Light aircraft", // under 15,500 lb
      A2: "Small aircraft", // 15,500–75,000 lb
      A3: "Large aircraft", // 75,000–300,000 lb
      A4: "Large (757)", // high-vortex large
      A5: "Heavy aircraft", // over 300,000 lb
      A6: "High performance",
      A7: "Helicopter",
      B1: "Glider",
      B2: "Balloon/Airship",
      B4: "Ultralight",
      B6: "Drone",
    };

    function aircraftType(f) {
      if (f.category === "A7") return "Helicopter";
      if (hexUpper(f).startsWith("AE")) return "Military";
      return CATEGORY_LABELS[f.category] ?? "—";
    }

    function isStale(f) {
      return typeof f.seen === "number" && f.seen > STALE_AFTER_MS / 1000;
    }

    function secondsSinceSeen(f) {
      if (typeof f.seen === "number") return Math.round(f.seen);
      return "—";
    }

    function callsignDisplay(f) {
      const cs = callsignRaw(f);
      return cs || "No callsign";
    }

    /* ---------- RENDER LIVE FLIGHTS ---------- */

    function render(flights) {
      const activeFlights = flights
        .filter((f) => !isStale(f))
        .sort(
          (a, b) => (aircraftDistance(b) ?? 0) - (aircraftDistance(a) ?? 0)
        );

      overheadCountEl.textContent = activeFlights.length
        ? `${activeFlights.length} in range`
        : "";
      if (!activeFlights.length) {
        tbody.innerHTML = "";
        emptyStateEl.classList.remove("hidden");
        return;
      }

      emptyStateEl.classList.add("hidden");

      tbody.innerHTML = activeFlights
        .map((f) => {
          if (isUnknownAirline(f)) {
            console.log("[UNKNOWN_AIRLINE]", {
              callsign: callsignRaw(f),
              hex: f.hex,
              alt: f.alt_baro ?? f.alt_geom,
              gs: f.gs,
              distance_nm: aircraftDistance(f),
              seen_s: f.seen,
            });
          }
          const note = classifyNotability(f);
          const d = aircraftDistance(f);
          const dFlag = d != null ? distanceFlag(d) : null;
          return `
          <tr class="border-b border-base-300 text-base-content">
            <td class="py-2 px-1.5 text-base-content/40"><div class="flex flex-wrap gap-1">
              ${
                note || dFlag
                  ? `
                ${note ? `<span class="px-2 py-0.5 rounded text-xs font-medium ${note.cls}">${note.label}</span>` : ""}
                ${dFlag ? `<span class="px-2 py-0.5 rounded text-xs font-medium ${dFlag.cls}">${dFlag.label}</span>` : ""}
              `
                  : "—"
              }
            </div></td>
            <td class="py-2 px-1.5 whitespace-nowrap">${escapeHtml(airlineFromFlight(f))}${phoneCallsign(callsignDisplay(f))}</td>
            <td class="py-2 px-1.5 whitespace-nowrap hidden sm:table-cell">${escapeHtml(callsignDisplay(f))}</td>
            <td class="py-2 px-1.5 hidden md:table-cell whitespace-nowrap">${aircraftType(f)}</td>
            <td class="py-2 px-1.5 hidden lg:table-cell">${escapeHtml(f.hex || "—")}</td>
            <td class="text-right py-2 px-1.5">${escapeHtml(f.alt_baro ?? f.alt_geom ?? "—")}</td>
            <td class="text-right py-2 px-1.5 hidden md:table-cell">${escapeHtml(f.gs ?? "—")}</td>
            <td class="text-right py-2 px-1.5 font-mono hidden lg:table-cell">${escapeHtml(f.squawk ?? "—")}</td>
            <td class="text-right py-2 px-1.5">${d != null ? Math.round(d) : "—"}</td>
            <td class="text-right py-2 px-1.5 hidden md:table-cell">${secondsSinceSeen(f)}</td>
          </tr>`;
        })
        .join("");
    }

    // Shares the map's /api/flights poll; everything pauses while the tab is hidden.
    subscribeFlights((data) => {
      render(data.aircraft ?? []);
      lastUpdatedEl.textContent =
        " Updated " + new Date(data.receivedAt).toLocaleTimeString();
    });
    pollWhileVisible(loadNotables, 60000);
    pollWhileVisible(loadFrequentFliers, 300000);
    pollWhileVisible(loadHeatmap, 300000);
    pollWhileVisible(loadCoverage, 300000);

    /* ---------- HEATMAP ---------- */

    const DAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    const HOURS = Array.from({ length: 24 }, (_, i) =>
      i === 0 ? "12a" : i < 12 ? `${i}a` : i === 12 ? "12p" : `${i - 12}p`
    );

    // One hue, light to dark (light theme) or dark to bright (dark theme).
    const HEATMAP_RAMPS = {
      light: { empty: "#f1f3f5", from: [232, 240, 250], to: [18, 64, 125], label: "#6b7280" },
      dark: { empty: "#272b31", from: [30, 42, 58], to: [140, 192, 255], label: "#9ca3af" },
    };

    let heatmapData = null;
    let heatmapType = "all";
    let heatmapScope = "any";
    let heatmapTall = false;
    const HEATMAP_FLIP_WIDTH = 640;

    const heatmapRamp = () =>
      HEATMAP_RAMPS[document.documentElement.getAttribute("data-theme") === "lofi-dark" ? "dark" : "light"];

    function heatmapColor(intensity, ramp) {
      const mix = ramp.from.map((c, i) => Math.round(c + (ramp.to[i] - c) * intensity));
      return `rgb(${mix.join(",")})`;
    }

    function mountainNow() {
      const parts = Object.fromEntries(
        new Intl.DateTimeFormat("en-US", { timeZone: "America/Denver", weekday: "short", hour: "numeric", hourCycle: "h23" })
          .formatToParts(new Date())
          .map((p) => [p.type, p.value])
      );
      return { weekday: DAYS.indexOf(parts.weekday), hour: Number(parts.hour) % 24 };
    }

    function syncHeatmapButtons() {
      document.querySelectorAll("#heatmapTypes [data-type]").forEach((b) =>
        b.classList.toggle("btn-active", b.dataset.type === heatmapType)
      );
      document.querySelectorAll("#heatmapScopes [data-scope]").forEach((b) =>
        b.classList.toggle("btn-active", b.dataset.scope === heatmapScope)
      );
    }

    function renderHeatmap() {
      const container = document.getElementById("heatmapGrid");
      if (!container || !heatmapData) return;
      syncHeatmapButtons();

      const grid = heatmapData.grids[`${heatmapType}|${heatmapScope}`];
      const ramp = heatmapRamp();
      const dark = ramp === HEATMAP_RAMPS.dark;
      // Square root so quiet hours still show some shade next to the busiest one.
      const max = Math.sqrt(Math.max(...grid.flat()));
      const now = mountainNow();
      // Narrow cards (phones) flip the grid: days across the top, hours down the side.
      const tall = container.clientWidth < HEATMAP_FLIP_WIDTH;
      heatmapTall = tall;

      const since = document.getElementById("heatmapSince");
      const days = heatmapData.daysPerWeekday.reduce((a, b) => a + b, 0);
      if (since) {
        since.textContent = heatmapData.since && days < 90
          ? ` Collecting since ${new Date(`${heatmapData.since}T12:00:00`).toLocaleDateString(undefined, { month: "short", day: "numeric" })}, so averages will settle over the coming weeks.`
          : "";
      }

      function cell(d, h) {
        const val = grid[d][h];
        const intensity = max ? Math.sqrt(val) / max : 0;
        const bg = val ? heatmapColor(intensity, ramp) : ramp.empty;
        const textColor = (intensity > 0.55) !== dark ? "#fff" : dark ? "#0b1220" : "#374151";
        // Whole numbers as-is; one decimal only when it says something (4.3, not 4.0).
        const shown = val >= 10 || Number.isInteger(val) ? String(Math.round(val)) : val.toFixed(1);
        const top = heatmapType === "all" || heatmapType === "airline" ? heatmapData.topAirline[d][h] : null;
        // Lines for the hover tooltip: when, how many, most common airline.
        const tip = [
          `${DAYS[d]} ${HOURS[h]}`,
          `${shown} ${heatmapType === "heli" ? "helicopter" : "plane"}${val === 1 ? "" : "s"} on average`,
          top ? `Most common: ${top}` : "",
        ].filter(Boolean).join("\n");
        const isNow = d === now.weekday && h === now.hour;
        const outline = isNow ? `outline:2px solid ${ramp.label}; outline-offset:1px;` : "";
        return `<td data-tip="${escapeHtml(tip)}" style="height:${tall ? 26 : 34}px; background:${bg}; ${outline} border-radius:3px; text-align:center; vertical-align:middle; color:${textColor}; cursor:default; font-size:10px;">`
          + `<span${val ? "" : ` style="color:${ramp.label};"`}>${shown}</span></td>`;
      }

      const labelStyle = `color:${ramp.label}; font-weight:500; white-space:nowrap;`;
      const cols = tall ? DAYS : HOURS;
      const rows = tall ? HOURS : DAYS;
      // Fixed layout so the cells share the card's width instead of setting it.
      let html = `<table style="width:100%; table-layout:fixed; border-collapse:separate; border-spacing:3px; font-size:11px;">`;
      html += `<colgroup><col style="width:36px">${cols.map(() => "<col>").join("")}</colgroup>`;
      html += `<thead><tr><th></th>`;
      for (const c of cols) html += `<th style="${labelStyle} text-align:center; padding-bottom:4px;">${c}</th>`;
      html += `</tr></thead><tbody>`;
      rows.forEach((r, i) => {
        html += `<tr><td style="${labelStyle} text-align:right; padding-right:6px;">${r}</td>`;
        for (let j = 0; j < cols.length; j++) html += tall ? cell(j, i) : cell(i, j);
        html += `</tr>`;
      });
      html += `</tbody></table>`;

      html += `<div style="margin-top:12px; display:flex; align-items:center; gap:6px; font-size:12px; color:${ramp.label};">`;
      html += `<span>Less</span>`;
      for (let i = 0; i <= 8; i++) {
        html += `<div style="width:18px; height:18px; background:${heatmapColor(i / 8, ramp)}; border-radius:2px;"></div>`;
      }
      html += `<span>More</span></div>`;

      container.innerHTML = html;
    }

    document.getElementById("heatmapTypes")?.addEventListener("click", (e) => {
      const type = e.target.closest("[data-type]")?.dataset.type;
      if (type) { heatmapType = type; renderHeatmap(); }
    });
    document.getElementById("heatmapScopes")?.addEventListener("click", (e) => {
      const scope = e.target.closest("[data-scope]")?.dataset.scope;
      if (scope) { heatmapScope = scope; renderHeatmap(); }
    });
    window.addEventListener("themechange", renderHeatmap);
    // Re-render only when the card crosses the width where the grid flips.
    new ResizeObserver(([entry]) => {
      if (heatmapData && (entry.contentRect.width < HEATMAP_FLIP_WIDTH) !== heatmapTall) renderHeatmap();
    }).observe(document.getElementById("heatmapGrid"));

    // Custom tooltip: the browser's title tooltip is slow and never shows on touch.
    const heatmapTip = document.createElement("div");
    heatmapTip.className =
      "fixed z-50 pointer-events-none hidden rounded-md border border-base-300 bg-base-100 text-base-content shadow-lg px-3 py-2 text-xs leading-5";
    document.body.appendChild(heatmapTip);

    function showHeatmapTip(cell, x, y) {
      const [first, ...rest] = cell.dataset.tip.split("\n");
      heatmapTip.replaceChildren();
      const head = document.createElement("div");
      head.className = "font-semibold";
      head.textContent = first;
      heatmapTip.append(head, ...rest.map((line) => Object.assign(document.createElement("div"), { textContent: line })));
      heatmapTip.classList.remove("hidden");
      // Keep it on screen near the pointer.
      const { width, height } = heatmapTip.getBoundingClientRect();
      const left = Math.min(x + 14, window.innerWidth - width - 8);
      const top = y + 14 + height > window.innerHeight ? y - height - 10 : y + 14;
      heatmapTip.style.left = `${Math.max(8, left)}px`;
      heatmapTip.style.top = `${Math.max(8, top)}px`;
    }

    const TIP_TARGETS = "#heatmapGrid td[data-tip], #coverageRose [data-tip]";
    for (const el of [document.getElementById("heatmapGrid"), document.getElementById("coverageRose")]) {
      el?.addEventListener("pointermove", (e) => {
        if (e.pointerType !== "mouse") return;
        const target = e.target.closest(TIP_TARGETS);
        if (target) showHeatmapTip(target, e.clientX, e.clientY);
        else heatmapTip.classList.add("hidden");
      });
      el?.addEventListener("pointerleave", (e) => {
        if (e.pointerType === "mouse") heatmapTip.classList.add("hidden");
      });
    }
    // Touch: tap a cell or wedge to show its tooltip, tap anywhere else to hide it.
    document.addEventListener("click", (e) => {
      const target = e.target.closest?.(TIP_TARGETS);
      if (!target) return heatmapTip.classList.add("hidden");
      const r = target.getBoundingClientRect();
      showHeatmapTip(target, e.clientX || r.left + r.width / 2, e.clientY || r.bottom);
    });
    window.addEventListener("scroll", () => heatmapTip.classList.add("hidden"), { passive: true });

    async function loadHeatmap() {
      try {
        const res = await fetch("/api/heatmap");
        heatmapData = await res.json();
        renderHeatmap();
      } catch {}
    }

    /* ---------- COVERAGE ROSE ---------- */

    const COMPASS = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"];
    const ROSE_COLORS = {
      light: { typical: "rgba(30,78,160,0.85)", best: "rgba(59,130,246,0.22)", grid: "#d1d5db", label: "#6b7280", halo: "#ffffff" },
      dark: { typical: "rgba(140,192,255,0.85)", best: "rgba(140,192,255,0.2)", grid: "#3a3d44", label: "#9ca3af", halo: "#17181b" },
    };

    let coverageData = null;
    let coverageWindow = "30";

    const compassName = (deg) => COMPASS[Math.round(deg / 22.5) % 16];

    function rosePoint(deg, r) {
      const rad = (deg * Math.PI) / 180;
      return `${(r * Math.sin(rad)).toFixed(2)},${(-r * Math.cos(rad)).toFixed(2)}`;
    }

    // A pie slice from the centre, with a sliver of gap so neighbours stay distinct.
    function wedge(from, to, r) {
      if (r <= 0) return "";
      const a = from + 0.6;
      const b = to - 0.6;
      return `M0,0 L${rosePoint(a, r)} A${r},${r} 0 0 1 ${rosePoint(b, r)} Z`;
    }

    function renderCoverage() {
      const el = document.getElementById("coverageRose");
      const statsEl = document.getElementById("coverageStats");
      if (!el || !coverageData) return;
      document.querySelectorAll("#coverageWindows [data-window]").forEach((b) =>
        b.classList.toggle("btn-active", b.dataset.window === coverageWindow)
      );

      const { sectorDeg } = coverageData;
      const { typical, best, days } = coverageData.windows[coverageWindow];
      const colors = ROSE_COLORS[heatmapRamp() === HEATMAP_RAMPS.dark ? "dark" : "light"];
      const ringMax = Math.max(100, Math.ceil(Math.max(...best) / 50) * 50);
      const R = 100;
      const scale = (nm) => (nm / ringMax) * R;

      let svg = `<svg viewBox="-118 -118 236 236" width="100%" height="100%" role="img" aria-label="Reception range by compass direction" style="overflow:visible">`;
      for (let nm = 50; nm <= ringMax; nm += 50) {
        svg += `<circle r="${scale(nm)}" fill="none" stroke="${colors.grid}" stroke-width="0.5"/>`;
      }
      for (const deg of [0, 90, 180, 270]) {
        svg += `<line x1="0" y1="0" x2="${rosePoint(deg, R).split(",")[0]}" y2="${rosePoint(deg, R).split(",")[1]}" stroke="${colors.grid}" stroke-width="0.5"/>`;
      }
      typical.forEach((_, s) => {
        svg += `<path d="${wedge(s * sectorDeg, (s + 1) * sectorDeg, scale(best[s]))}" fill="${colors.best}"/>`;
      });
      typical.forEach((t, s) => {
        svg += `<path d="${wedge(s * sectorDeg, (s + 1) * sectorDeg, scale(t))}" fill="${colors.typical}"/>`;
      });
      // Ring distances over the wedges, with a halo so they read on any fill.
      for (let nm = 50; nm <= ringMax; nm += 50) {
        svg += `<text x="${(scale(nm) * 0.707 + 1.5).toFixed(1)}" y="${(-scale(nm) * 0.707 - 1.5).toFixed(1)}" font-size="6" fill="${colors.label}" stroke="${colors.halo}" stroke-width="2" paint-order="stroke">${nm}</text>`;
      }
      // Full-radius transparent slices on top, so every direction has a hover target.
      typical.forEach((t, s) => {
        const from = s * sectorDeg;
        const tip = [
          `${compassName(from + sectorDeg / 2)} (${from}°–${from + sectorDeg}°)`,
          t ? `Typical day: ${t} NM` : "No flights heard this way",
          best[s] ? `Best ping: ${best[s]} NM` : "",
        ].filter(Boolean).join("\n");
        svg += `<path d="${wedge(from - 0.6, from + sectorDeg + 0.6, R)}" fill="transparent" data-tip="${escapeHtml(tip)}"/>`;
      });
      for (const [label, deg] of [["N", 0], ["E", 90], ["S", 180], ["W", 270]]) {
        const [x, y] = rosePoint(deg, R + 10).split(",");
        svg += `<text x="${x}" y="${y}" font-size="8" font-weight="600" fill="${colors.label}" text-anchor="middle" dominant-baseline="central">${label}</text>`;
      }
      svg += `<circle r="2" fill="#ef4444" stroke="#fff" stroke-width="0.8"/>`;
      svg += `</svg>`;
      el.innerHTML = svg;

      // Summary: furthest and weakest directions, ignoring directions with no traffic.
      const heard = typical.map((t, s) => ({ s, t, b: best[s] })).filter((x) => x.t > 0);
      const dirName = (s) => compassName(s * sectorDeg + sectorDeg / 2);
      const stat = (label, value, note) =>
        `<div><dt class="text-base-content/50 text-xs">${label}</dt><dd class="text-lg font-semibold">${value}</dd>${note ? `<dd class="text-xs text-base-content/50">${note}</dd>` : ""}</div>`;
      if (!heard.length) {
        statsEl.innerHTML = `<p class="col-span-2 text-base-content/50">No range data for this period yet.</p>`;
      } else {
        const furthest = heard.reduce((a, b) => (b.b > a.b ? b : a));
        const strongest = heard.reduce((a, b) => (b.t > a.t ? b : a));
        const weakest = heard.reduce((a, b) => (b.t < a.t ? b : a));
        const avg = Math.round(heard.reduce((n, x) => n + x.t, 0) / heard.length);
        statsEl.innerHTML =
          stat("Best ping", `${furthest.b} NM`, `to the ${dirName(furthest.s)}`) +
          stat("Typical reach", `${avg} NM`, "average across directions") +
          stat("Strongest direction", dirName(strongest.s), `${strongest.t} NM on a typical day`) +
          stat("Weakest direction", dirName(weakest.s), `${weakest.t} NM on a typical day`);
      }

      const sinceEl = document.getElementById("coverageSince");
      if (sinceEl) {
        const since = coverageData.since && new Date(`${coverageData.since}T12:00:00`);
        sinceEl.textContent = since && days < Number(coverageWindow)
          ? `Based on ${days} day${days === 1 ? "" : "s"} of data, collecting since ${since.toLocaleDateString(undefined, { month: "short", day: "numeric" })}.`
          : `Based on ${days} days of data.`;
      }
    }

    document.getElementById("coverageWindows")?.addEventListener("click", (e) => {
      const w = e.target.closest("[data-window]")?.dataset.window;
      if (w) { coverageWindow = w; renderCoverage(); }
    });
    window.addEventListener("themechange", renderCoverage);

    async function loadCoverage() {
      try {
        const res = await fetch("/api/coverage");
        coverageData = await res.json();
        renderCoverage();
      } catch {}
    }
  </script>
</BaseLayout>
