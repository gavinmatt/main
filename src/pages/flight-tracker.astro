---
import BaseLayout from "../layouts/BaseLayout.astro";
import FlightMap from "../components/FlightMap.tsx";
---

<BaseLayout
  sideBarActiveItemID="flight-tracker"
  customTitle="Flight Tracker"
  description="Live ADS-B aircraft tracking from a personal antenna in northwest Montana. View current overhead flights and the furthest-away aircraft ever received."
  canonical="https://www.gavmatt.com/flight-tracker"
  ogImage="https://www.gavmatt.com/flight-tracker.png"
>
  <!-- HEADER -->
  <div class="text-5xl font-bold text-center mt-6">
    Live air traffic near Whitefish, MT
  </div>

  <p class="text-center py-4 max-w-3xl mx-auto">
    All data is captured from my home ADS-B antenna setup and reflects only
    aircraft my local receiver can hear (not aggregated radar data).
    <a href="/blog/flight-tracking" class="underline">Learn more</a>.
  </p>

  <!-- RADAR -->
  <div class="flex justify-center px-4">
    <FlightMap client:only="react" />
  </div>

  <!-- TAB NAVIGATION -->
  <div
    class="mt-12"
    style="width: 100%; max-width: 1280px; margin-left: auto; margin-right: auto; padding-left: 1rem; padding-right: 1rem;"
  >
    <div class="flex border-b border-base-300 gap-1 w-full">
      <button
        id="tab-overhead"
        class="tab-btn px-5 py-2.5 text-base font-bold border-b-2 border-base-content text-base-content -mb-px"
        onclick="switchTab('overhead')"
      >
        What's overhead?
      </button>
      <button
        id="tab-distant"
        class="tab-btn px-5 py-2.5 text-base font-bold border-b-2 border-transparent text-base-content/50 -mb-px hover:text-base-content"
        onclick="switchTab('distant')"
      >
        Distant pings
      </button>
      <button
        id="tab-frequent"
        class="tab-btn px-5 py-2.5 text-base font-bold border-b-2 border-transparent text-base-content/50 -mb-px hover:text-base-content"
        onclick="switchTab('frequent')"
      >
        Frequent fliers
      </button>
      <button
        id="tab-heatmap"
        class="tab-btn px-5 py-2.5 text-base font-bold border-b-2 border-transparent text-base-content/50 -mb-px hover:text-base-content"
        onclick="switchTab('heatmap')"
      >
        Traffic heatmap
      </button>
    </div>

    <!-- TAB: OVERHEAD -->
    <div id="panel-overhead" class="tab-panel pt-6 w-full" style="width:100%">
      <p class="text-base-content mb-3 text-base">
        Data about the planes currently flying in reach of my antenna. "—" and
        missing values are expected - not all planes send data and data is lost
        at range. The table will also flag interesting or uncommon flights.
      </p>
      <p id="lastUpdated" class="text-base text-base-content/50 mb-4"></p>

      <div
        id="emptyState"
        class="hidden mt-4 mb-4 text-center border border-dashed rounded-lg py-10 px-6 text-base-content/50"
      >
        <div class="text-xl font-semibold mb-2">
          No aircraft currently in range
        </div>
        <p class="text-sm">
          My receiver is online and listening, but there are no aircraft
          transmitting decodable ADS-B data within range right now.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm text-base-content">
          <thead>
            <tr class="border-b text-base-content/70">
              <th class="text-left py-2 px-1.5">Interesting?</th>
              <th class="text-left py-2 px-1.5">Airline</th>
              <th class="text-left py-2 px-1.5">Callsign</th>
              <th class="text-left py-2 px-1.5">Type</th>
              <th class="text-left py-2 px-1.5">ICAO</th>
              <th class="text-right py-2 px-1.5">Alt (ft)</th>
              <th class="text-right py-2 px-1.5">Speed (kt)</th>
              <th class="text-right py-2 px-1.5">Squawk</th>
              <th class="text-right py-2 px-1.5">Dist (NM)</th>
              <th class="text-right py-2 px-1.5">Seen (s)</th>
            </tr>
          </thead>
          <tbody id="flightBody" class="text-base-content"></tbody>
        </table>
      </div>
    </div>

    <!-- TAB: DISTANT PINGS -->
    <div
      id="panel-distant"
      class="tab-panel pt-6 hidden w-full"
      style="width:100%"
    >
      <p class="text-base-content mb-1 text-base">
        Furthest away aircraft I've tracked. 1 NM = ~1.15 miles.
      </p>
      <p class="text-base-content mb-4 text-base">
        Good = 120–180 NM, great = 180–250 NM, amazing = 250+ NM for my setup.
      </p>

      <div class="overflow-x-auto">
        <table class="min-w-full border-collapse text-base text-base-content">
          <thead>
            <tr class="border-b text-base-content/70">
              <th class="text-center py-2 px-3">Ranking</th>
              <th class="text-center py-2 px-3">Distance Rating</th>
              <th class="text-left py-2 px-3">Airline</th>
              <th class="text-left py-2 px-3">Callsign</th>
              <th class="text-right py-2 px-3">Max Distance (NM)</th>
              <th class="text-right py-2 px-3">Last Seen</th>
            </tr>
          </thead>
          <tbody id="notableBody"></tbody>
        </table>
      </div>
    </div>

    <!-- TAB: FREQUENT FLIERS -->
    <div
      id="panel-frequent"
      class="tab-panel pt-6 hidden w-full"
      style="width:100%"
    >
      <p class="text-base-content mb-4 text-base">
        Callsigns I've seen pass through most often. Route callsigns repeat
        daily, so this is effectively a ranking of the busiest routes over my
        antenna.
      </p>

      <div class="overflow-x-auto">
        <table class="min-w-full border-collapse text-base text-base-content">
          <thead>
            <tr class="border-b text-base-content/70">
              <th class="text-center py-2 px-3">Ranking</th>
              <th class="text-left py-2 px-3">Airline</th>
              <th class="text-left py-2 px-3">Callsign</th>
              <th class="text-right py-2 px-3">Times Seen</th>
              <th class="text-right py-2 px-3">Last Seen</th>
            </tr>
          </thead>
          <tbody id="frequentFliersBody"></tbody>
        </table>
      </div>
    </div>

    <!-- TAB: HEATMAP -->
    <div
      id="panel-heatmap"
      class="tab-panel pt-6 hidden w-full"
      style="width:100%"
    >
      <p class="text-base-content mb-1 text-base">
        Unique flights overhead by hour and day of week (Mountain Time, rolling
        90 days).
      </p>
      <p class="text-base-content/50 mb-6 text-sm">
        Darker = more traffic. Each cell counts distinct ICAO codes — a flight
        seen multiple times in the same hour only counts once.
      </p>

      <div id="heatmapContainer" class="overflow-x-auto">
        <div id="heatmapGrid"></div>
      </div>
    </div>
  </div>

  <!-- SCRIPT -->
  <script>
    import {
      airlineFromCallsign,
      airlineFromFlight,
      callsignRaw,
      classifyNotability,
      distanceNm,
      escapeHtml,
      hexUpper,
      isUnknownAirline,
      militaryBranch,
    } from "../lib/flightClassify.js";

    /* ---------- TAB SWITCHING ---------- */

    window.switchTab = function (name) {
      document.querySelectorAll(".tab-panel").forEach((p) => {
        p.style.height = "0";
        p.style.overflow = "hidden";
        p.style.paddingTop = "0";
      });
      document.querySelectorAll(".tab-btn").forEach((b) => {
        b.classList.remove("border-base-content", "text-base-content");
        b.classList.add("border-transparent", "text-base-content/50");
      });
      const panel = document.getElementById("panel-" + name);
      panel.style.height = "auto";
      panel.style.overflow = "visible";
      panel.style.paddingTop = "1.5rem";
      const btn = document.getElementById("tab-" + name);
      btn.classList.remove("border-transparent", "text-base-content/50");
      btn.classList.add("border-base-content", "text-base-content");
    };

    // Init: collapse non-overhead panels
    ["panel-distant", "panel-frequent", "panel-heatmap"].forEach((id) => {
      const p = document.getElementById(id);
      p.classList.remove("hidden");
      p.style.height = "0";
      p.style.overflow = "hidden";
      p.style.paddingTop = "0";
    });

    /* ---------- CONSTANTS ---------- */

    const tbody = document.getElementById("flightBody");
    const emptyStateEl = document.getElementById("emptyState");
    const lastUpdatedEl = document.getElementById("lastUpdated");
    const STALE_AFTER_MS = 90_000;

    const RX_LAT = 48.415;
    const RX_LON = -114.459;

    /* ---------- UTILS ---------- */

    function aircraftDistance(f) {
      if (f.lat == null || f.lon == null) return null;
      return distanceNm(RX_LAT, RX_LON, f.lat, f.lon);
    }

    function distanceFlag(d) {
      if (d > 250)
        return { label: "EXTREME", cls: "bg-purple-100 text-purple-800" };
      if (d > 200)
        return { label: "LONG-RANGE", cls: "bg-indigo-100 text-indigo-800" };
      if (d > 150)
        return { label: "DISTANT", cls: "bg-blue-100 text-blue-800" };
      return null;
    }

    function notableLabelForFlight(f) {
      const branch = militaryBranch(f);
      if (branch) return branch.replace(" (TANKER)", "");
      return airlineFromFlight(f);
    }

    function notableDistanceLabel(d) {
      if (d >= 250)
        return { label: "AMAZING", cls: "bg-purple-100 text-purple-800" };
      if (d >= 180)
        return { label: "GREAT", cls: "bg-indigo-100 text-indigo-800" };
      if (d >= 120) return { label: "GOOD", cls: "bg-blue-100 text-blue-800" };
      return null;
    }

    /* ---------- NOTABLES ---------- */

    function renderNotables(rows) {
      const notableBody = document.getElementById("notableBody");
      if (!notableBody) return;
      if (!rows || !rows.length) {
        notableBody.innerHTML = `<tr><td colspan="6" class="text-center py-6 text-base-content/50">No notable pings recorded yet.</td></tr>`;
        return;
      }
      const medals = ["🥇", "🥈", "🥉"];
      notableBody.innerHTML = rows
        .map((r, i) => {
          const fakeFlight = { flight: r.callsign };
          const rank = medals[i] ?? "";
          const label = notableDistanceLabel(r.maxDistance);
          return `
          <tr class="border-b">
            <td class="text-center py-2 px-3 text-xl">${rank}</td>
            <td class="text-center py-2 px-3">
              ${label ? `<span class="px-2 py-0.5 rounded text-xs font-medium ${label.cls}">${label.label}</span>` : "—"}
            </td>
            <td class="py-2 px-3">${escapeHtml(r.airline && r.airline !== "—" ? r.airline : notableLabelForFlight(fakeFlight))}</td>
            <td class="py-2 px-3">${escapeHtml(r.callsign)}</td>
            <td class="text-right py-2 px-3 font-semibold">${escapeHtml(r.maxDistance)}</td>
            <td class="text-right py-2 px-3">${new Date(r.lastSeen).toLocaleDateString()}</td>
          </tr>`;
        })
        .join("");
    }

    async function loadNotables() {
      try {
        const res = await fetch("/api/notable-pings");
        const data = await res.json();
        renderNotables(data.rows ?? []);
      } catch {}
    }

    /* ---------- FREQUENT FLIERS ---------- */

    function renderFrequentFliers(rows) {
      const ffBody = document.getElementById("frequentFliersBody");
      if (!ffBody) return;
      if (!rows || !rows.length) {
        ffBody.innerHTML = `<tr><td colspan="5" class="text-center py-6 text-base-content/50">No frequent fliers recorded yet.</td></tr>`;
        return;
      }
      const medals = ["🥇", "🥈", "🥉"];
      ffBody.innerHTML = rows
        .map((r, i) => {
          const rank = medals[i] ?? "";
          return `
          <tr class="border-b">
            <td class="text-center py-2 px-3 text-xl">${rank}</td>
            <td class="py-2 px-3">${escapeHtml(airlineFromCallsign(r.callsign))}</td>
            <td class="py-2 px-3 font-mono">${escapeHtml(r.callsign)}</td>
            <td class="text-right py-2 px-3 font-semibold">${escapeHtml(r.count)}</td>
            <td class="text-right py-2 px-3">${new Date(r.lastSeen).toLocaleDateString()}</td>
          </tr>`;
        })
        .join("");
    }

    async function loadFrequentFliers() {
      try {
        const res = await fetch("/api/frequent-fliers");
        const data = await res.json();
        renderFrequentFliers(data.rows ?? []);
      } catch {}
    }

    // ADS-B emitter categories are weight classes, not engine types.
    const CATEGORY_LABELS = {
      A1: "Light aircraft", // under 15,500 lb
      A2: "Small aircraft", // 15,500–75,000 lb
      A3: "Large aircraft", // 75,000–300,000 lb
      A4: "Large (757)", // high-vortex large
      A5: "Heavy aircraft", // over 300,000 lb
      A6: "High performance",
      A7: "Helicopter",
      B1: "Glider",
      B2: "Balloon/Airship",
      B4: "Ultralight",
      B6: "Drone",
    };

    function aircraftType(f) {
      if (f.category === "A7") return "Helicopter";
      if (hexUpper(f).startsWith("AE")) return "Military";
      return CATEGORY_LABELS[f.category] ?? "—";
    }

    function isStale(f) {
      return typeof f.seen === "number" && f.seen > STALE_AFTER_MS / 1000;
    }

    function secondsSinceSeen(f) {
      if (typeof f.seen === "number") return Math.round(f.seen);
      return "—";
    }

    function callsignDisplay(f) {
      const cs = callsignRaw(f);
      return cs || "No callsign";
    }

    /* ---------- RENDER LIVE FLIGHTS ---------- */

    function render(flights) {
      const activeFlights = flights
        .filter((f) => !isStale(f))
        .sort(
          (a, b) => (aircraftDistance(b) ?? 0) - (aircraftDistance(a) ?? 0)
        );

      if (!activeFlights.length) {
        tbody.innerHTML = "";
        emptyStateEl.classList.remove("hidden");
        return;
      }

      emptyStateEl.classList.add("hidden");

      tbody.innerHTML = activeFlights
        .map((f) => {
          if (isUnknownAirline(f)) {
            console.log("[UNKNOWN_AIRLINE]", {
              callsign: callsignRaw(f),
              hex: f.hex,
              alt: f.alt_baro ?? f.alt_geom,
              gs: f.gs,
              distance_nm: aircraftDistance(f),
              seen_s: f.seen,
            });
          }
          const note = classifyNotability(f);
          const d = aircraftDistance(f);
          const dFlag = d != null ? distanceFlag(d) : null;
          return `
          <tr class="border-b text-base-content">
            <td class="py-2 px-1.5 space-x-1 text-base-content/40">
              ${
                note || dFlag
                  ? `
                ${note ? `<span class="px-2 py-0.5 rounded text-xs font-medium ${note.cls}">${note.label}</span>` : ""}
                ${dFlag ? `<span class="px-2 py-0.5 rounded text-xs font-medium ${dFlag.cls}">${dFlag.label}</span>` : ""}
              `
                  : "—"
              }
            </td>
            <td class="py-2 px-1.5">${escapeHtml(airlineFromFlight(f))}</td>
            <td class="py-2 px-1.5">${escapeHtml(callsignDisplay(f))}</td>
            <td class="py-2 px-1.5">${aircraftType(f)}</td>
            <td class="py-2 px-1.5">${escapeHtml(f.hex || "—")}</td>
            <td class="text-right py-2 px-1.5">${escapeHtml(f.alt_baro ?? f.alt_geom ?? "—")}</td>
            <td class="text-right py-2 px-1.5">${escapeHtml(f.gs ?? "—")}</td>
            <td class="text-right py-2 px-1.5 font-mono">${escapeHtml(f.squawk ?? "—")}</td>
            <td class="text-right py-2 px-1.5">${d != null ? Math.round(d) : "—"}</td>
            <td class="text-right py-2 px-1.5">${secondsSinceSeen(f)}</td>
          </tr>`;
        })
        .join("");
    }

    async function updateFlights() {
      try {
        const res = await fetch("/api/flights");
        if (res.status === 204) return;
        const data = await res.json();
        render(data.aircraft ?? []);
        lastUpdatedEl.textContent =
          "Last updated " + new Date(data.receivedAt).toLocaleTimeString();
      } catch {}
    }

    updateFlights();
    setInterval(updateFlights, 10000);
    loadNotables();
    loadFrequentFliers();
    loadHeatmap();
    setInterval(loadNotables, 60000);
    setInterval(loadFrequentFliers, 60000);
    setInterval(loadHeatmap, 60000);

    /* ---------- HEATMAP ---------- */

    const DAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    const HOURS = Array.from({ length: 24 }, (_, i) =>
      i === 0 ? "12a" : i < 12 ? `${i}a` : i === 12 ? "12p" : `${i - 12}p`
    );

    function heatmapColor(value, max) {
      if (max === 0 || value === 0) return "#f3f4f6";
      const intensity = value / max;
      const r = Math.round(239 - intensity * 210);
      const g = Math.round(246 - intensity * 200);
      const b = Math.round(255 - intensity * 100);
      return `rgb(${r},${g},${b})`;
    }

    function renderHeatmap(grid) {
      const container = document.getElementById("heatmapGrid");
      if (!container) return;

      const max = Math.max(...grid.flatMap((row) => row));

      const cellSize = "36px";

      let html = `<table style="border-collapse:separate; border-spacing:3px; font-size:12px;">`;

      html += `<thead><tr><th style="width:36px"></th>`;
      for (const h of HOURS) {
        html += `<th style="width:${cellSize}; text-align:center; color:#6b7280; font-weight:500; padding-bottom:4px;">${h}</th>`;
      }
      html += `</tr></thead><tbody>`;

      for (let d = 0; d < 7; d++) {
        html += `<tr>`;
        html += `<td style="text-align:right; padding-right:8px; color:#6b7280; font-weight:500; white-space:nowrap;">${DAYS[d]}</td>`;
        for (let h = 0; h < 24; h++) {
          const val = grid[d][h];
          const bg = heatmapColor(val, max);
          const textColor = val / max > 0.5 ? "#fff" : "#374151";
          const title = `${DAYS[d]} ${HOURS[h]}: ${val} flight${val !== 1 ? "s" : ""}`;
          html += `<td title="${title}" style="width:${cellSize}; height:${cellSize}; background:${bg}; border-radius:3px; text-align:center; vertical-align:middle; color:${textColor}; cursor:default;">`;
          if (val > 0) html += `<span style="font-size:10px;">${val}</span>`;
          html += `</td>`;
        }
        html += `</tr>`;
      }

      html += `</tbody></table>`;

      html += `<div style="margin-top:12px; display:flex; align-items:center; gap:6px; font-size:12px; color:#6b7280;">`;
      html += `<span>Less</span>`;
      for (let i = 0; i <= 8; i++) {
        const bg = heatmapColor(i, 8);
        html += `<div style="width:18px; height:18px; background:${bg}; border-radius:2px; border:1px solid #e5e7eb;"></div>`;
      }
      html += `<span>More</span></div>`;

      container.innerHTML = html;
    }

    async function loadHeatmap() {
      try {
        const res = await fetch("/api/heatmap");
        const data = await res.json();
        renderHeatmap(data.grid);
      } catch {}
    }
  </script>
</BaseLayout>
