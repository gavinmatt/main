---
import WeatherLayout from "../layouts/WeatherLayout.astro";
import WeatherDashboard from "../components/WeatherDashboard.jsx";


const apiEndpoint = '/api/weather-dashboard';
---

<WeatherLayout sideBarActiveItemID="weather" customTitle="Whitefish Weather" 
customDescription="Live readings from my home weather station in Whitefish, plus NWS forecasts and alerts." 
customImage="/whitefish.png">
    <div class="text-5xl font-bold" style="text-align: center">
        Current Weather in Whitefish
    </div>
    <p style="text-align: center;padding-top:20px">
        Live readings from my Ambient Weather station at home, alongside forecasts and alerts from the
        National Weather Service. Everything refreshes on its own every couple of minutes.
    </p>
    <div style="padding-top:50px">
        <WeatherDashboard client:visible apiEndpoint={apiEndpoint} />
    </div>

</WeatherLayout>
